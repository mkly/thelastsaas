datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --- BetterAuth core models ---

model User {
  id                      String                 @id
  email                   String                 @unique
  emailVerified           Boolean                @default(false)
  name                    String
  image                   String?
  notificationPreferences Json?                  @map("notification_preferences")
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  sessions                Session[]
  accounts                Account[]
  members                 Member[]
  invitations             Invitation[]
  notifications           Notification[]
  notificationSchedules   NotificationSchedule[]
  oauthClients            OauthClient[]
  oauthRefreshTokens      OauthRefreshToken[]
  oauthAccessTokens       OauthAccessToken[]
  oauthConsents           OauthConsent[]

  @@map("user")
}

model Session {
  id                   String              @id
  userId               String
  token                String              @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  activeOrganizationId String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthRefreshTokens   OauthRefreshToken[]
  oauthAccessTokens    OauthAccessToken[]

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  userId                String
  issuer                String
  providerId            String
  accountId             String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// --- BetterAuth OAuth 2.1 / MCP provider models ---

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

model OauthClient {
  id                               String                @id
  clientId                         String                @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?              @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           Json?
  clientCredentialsScopes          Json?                 @default("[]")
  userId                           String?
  createdAt                        DateTime?
  updatedAt                        DateTime?
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         Json?
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     Json
  postLogoutRedirectUris           Json?
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       Json?
  responseTypes                    Json?
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?              @default(false)
  referenceId                      String?
  metadata                         Json?
  user                             User?                 @relation(fields: [userId], references: [id])
  resources                        OauthClientResource[]
  refreshTokens                    OauthRefreshToken[]
  accessTokens                     OauthAccessToken[]
  consents                         OauthConsent[]

  @@index([userId])
  @@map("oauthClient")
}

model OauthResource {
  id                            String                @id
  identifier                    String                @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 Json?
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?              @default(false)
  disabled                      Boolean?              @default(false)
  createdAt                     DateTime?
  updatedAt                     DateTime?
  policyVersion                 Int?                  @default(1)
  metadata                      Json?
  clients                       OauthClientResource[]

  @@map("oauthResource")
}

model OauthClientResource {
  id         String        @id
  clientId   String
  resourceId String
  metadata   Json?
  createdAt  DateTime?
  client     OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resource   OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)

  @@unique([clientId, resourceId])
  @@index([clientId])
  @@index([resourceId])
  @@map("oauthClientResource")
}

model OauthRefreshToken {
  id                      String             @id
  token                   String             @unique
  clientId                String
  sessionId               String?
  userId                  String
  referenceId             String?
  authorizationCodeId     String?
  resources               Json?
  requestedUserInfoClaims Json?
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  Json
  client                  OauthClient        @relation(fields: [clientId], references: [clientId])
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user                    User               @relation(fields: [userId], references: [id])
  accessTokens            OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauthRefreshToken")
}

model OauthAccessToken {
  id                      String             @id
  token                   String             @unique
  clientId                String
  sessionId               String?
  userId                  String?
  referenceId             String?
  authorizationCodeId     String?
  resources               Json?
  requestedUserInfoClaims Json?
  refreshId               String?
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  confirmation            Json?
  scopes                  Json
  client                  OauthClient        @relation(fields: [clientId], references: [clientId])
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user                    User?              @relation(fields: [userId], references: [id])
  refresh                 OauthRefreshToken? @relation(fields: [refreshId], references: [id])

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauthAccessToken")
}

model OauthConsent {
  id                      String      @id
  clientId                String
  userId                  String?
  referenceId             String?
  resources               Json?
  requestedUserInfoClaims Json?
  scopes                  Json
  createdAt               DateTime
  updatedAt               DateTime
  client                  OauthClient @relation(fields: [clientId], references: [clientId])
  user                    User?       @relation(fields: [userId], references: [id])

  @@index([clientId])
  @@index([userId])
  @@map("oauthConsent")
}

model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime

  @@map("oauthClientAssertion")
}

// --- BetterAuth organization plugin models ---

model Organization {
  id                    String                 @id
  name                  String
  slug                  String                 @unique
  logo                  String?
  metadata              String?
  createdAt             DateTime               @default(now())
  members               Member[]
  invitations           Invitation[]
  collections           Collection[]
  records               Record[]
  rowFilters            RowFilter[]
  fieldFilters          FieldFilter[]
  files                 File[]
  notifications         Notification[]
  notificationSchedules NotificationSchedule[]
  casbinRules           CasbinRule[]
  auditLogs             AuditLog[]

  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  userId         String
  role           String       @default("member")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  email          String
  role           String?
  status         String       @default("pending")
  inviterId      String
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// --- Application models ---

model Collection {
  id           String        @id
  orgId        String        @map("org_id")
  name         String
  schema       Json
  description  String        @default("")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  records      Record[]
  files        File[]
  rowFilters   RowFilter[]
  fieldFilters FieldFilter[]

  @@unique([orgId, name])
  @@unique([orgId, id])
  @@index([orgId])
  @@map("collections")
}

model Record {
  id           String       @id
  orgId        String       @map("org_id")
  collectionId String       @map("collection_id")
  data         Json
  createdBy    String       @default("system") @map("created_by")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  collection   Collection   @relation(fields: [orgId, collectionId], references: [orgId, id], onDelete: Cascade)
  files        File[]

  @@unique([orgId, id])
  @@index([orgId, collectionId])
  @@map("records")
}

model RowFilter {
  id           String       @id
  orgId        String       @map("org_id")
  collectionId String       @map("collection_id")
  role         String
  action       String
  condition    Json
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  collection   Collection   @relation(fields: [orgId, collectionId], references: [orgId, id], onDelete: Cascade)

  @@unique([orgId, collectionId, role, action])
  @@index([orgId, collectionId, action])
  @@map("row_filters")
}

model FieldFilter {
  id             String       @id
  orgId          String       @map("org_id")
  collectionId   String       @map("collection_id")
  role           String
  action         String
  readableFields Json         @map("readable_fields")
  writableFields Json         @map("writable_fields")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  collection     Collection   @relation(fields: [orgId, collectionId], references: [orgId, id], onDelete: Cascade)

  @@unique([orgId, collectionId, role, action])
  @@index([orgId, collectionId, action])
  @@map("field_filters")
}

model File {
  id           String       @id
  orgId        String       @map("org_id")
  path         String
  filename     String
  mimeType     String?      @map("mime_type")
  sizeBytes    Int?         @map("size_bytes")
  collectionId String?      @map("collection_id")
  recordId     String?      @map("record_id")
  uploadedBy   String       @default("system") @map("uploaded_by")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  collection   Collection?  @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  record       Record?      @relation(fields: [recordId], references: [id], onDelete: SetNull)

  @@unique([orgId, path])
  @@index([orgId, collectionId])
  @@index([orgId, recordId])
  @@map("files")
}

model Notification {
  id            String                @id
  orgId         String                @map("org_id")
  userId        String                @map("user_id")
  scheduleId    String?               @map("schedule_id")
  occurrenceAt  DateTime?             @map("occurrence_at")
  dedupeKey     String?               @map("dedupe_key")
  type          String
  message       String
  data          Json?
  read          Boolean               @default(false)
  inApp         Boolean               @default(true) @map("in_app")
  channel       String                @default("console")
  status        String                @default("pending")
  lockedAt      DateTime?             @map("locked_at")
  errorLogs     Json?                 @map("error_logs")
  attempts      Int                   @default(0)
  nextAttemptAt DateTime?             @map("next_attempt_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  org           Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule      NotificationSchedule? @relation(fields: [orgId, scheduleId], references: [orgId, id], onDelete: Restrict)

  @@unique([orgId, userId, dedupeKey])
  @@unique([orgId, scheduleId, occurrenceAt])
  @@index([orgId, userId, read])
  @@index([status, nextAttemptAt])
  @@map("notifications")
}

model NotificationSchedule {
  id               String         @id
  orgId            String         @map("org_id")
  userId           String         @map("user_id")
  dedupeKey        String         @map("dedupe_key")
  type             String
  message          String
  data             Json?
  inApp            Boolean        @default(true) @map("in_app")
  channel          String         @default("console")
  deliverAt        DateTime?      @map("deliver_at")
  recurrence       String?
  nextOccurrenceAt DateTime?      @map("next_occurrence_at")
  status           String         @default("scheduled")
  lockedAt         DateTime?      @map("locked_at")
  lastEnqueuedAt   DateTime?      @map("last_enqueued_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  org              Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications    Notification[]

  @@unique([orgId, id])
  @@unique([orgId, dedupeKey])
  @@index([status, deliverAt])
  @@index([status, nextOccurrenceAt])
  @@index([orgId, userId, status])
  @@map("notification_schedules")
}

model CasbinRule {
  id    Int          @id @default(autoincrement())
  orgId String       @map("org_id")
  ptype String
  v0    String?
  v1    String?
  v2    String?
  v3    String?
  v4    String?
  v5    String?
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, ptype])
  @@index([orgId, v0])
  @@map("casbin_rule")
}

model DeviceCode {
  id              String    @id
  deviceCode      String    @unique
  userCode        String    @unique
  userId          String?
  expiresAt       DateTime
  status          String
  lastPolledAt    DateTime?
  pollingInterval Int?
  clientId        String?
  scope           String?

  @@map("deviceCode")
}

model AuditLog {
  id           String       @id
  orgId        String       @map("org_id")
  userId       String       @default("system") @map("user_id")
  action       String
  resourceType String       @map("resource_type")
  resourceId   String?      @map("resource_id")
  details      Json?
  createdAt    DateTime     @default(now()) @map("created_at")
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([orgId, resourceType, resourceId])
  @@map("audit_log")
}
