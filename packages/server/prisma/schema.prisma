datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

generator kysely {
  provider = "prisma-kysely"
  output   = "../src/db/generated"
  fileName = "types.ts"
}

// --- BetterAuth core models ---

model User {
  id                      String                 @id
  email                   String                 @unique
  emailVerified           Boolean                @default(false)
  name                    String
  image                   String?
  kind                    String                 @default("human")
  notificationPreferences Json?                  @map("notification_preferences")
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  sessions                Session[]
  accounts                Account[]
  members                 Member[]
  invitations             Invitation[]
  notifications           Notification[]
  notificationSchedules   NotificationSchedule[]
  oauthClients            OauthClient[]
  oauthRefreshTokens      OauthRefreshToken[]
  oauthAccessTokens       OauthAccessToken[]
  oauthConsents           OauthConsent[]
  apiKeys                 Apikey[]
  mcpOrganizations        McpOrganization[]
  queueEntries            QueueEntry[]
  queueSchedules          QueueSchedule[]
  collectionTriggers      CollectionTrigger[]

  @@map("user")
}

model Session {
  id                   String              @id
  userId               String
  token                String              @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  activeOrganizationId String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthRefreshTokens   OauthRefreshToken[]
  oauthAccessTokens    OauthAccessToken[]

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  userId                String
  issuer                String
  providerId            String
  accountId             String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Apikey {
  id                  String    @id
  configId            String    @default("default")
  name                String?
  start               String?
  prefix              String?
  key                 String
  referenceId         String
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?  @default(true)
  rateLimitEnabled    Boolean?  @default(true)
  rateLimitTimeWindow Int?      @default(86400000)
  rateLimitMax        Int?      @default(10)
  requestCount        Int?      @default(0)
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  permissions         String?
  metadata            String?
  user                User      @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@index([key])
  @@index([referenceId])
  @@map("apikey")
}

// --- BetterAuth OAuth 2.1 / MCP provider models ---

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

model OauthClient {
  id                               String                @id
  clientId                         String                @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?              @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           Json?
  clientCredentialsScopes          Json?                 @default("[]")
  userId                           String?
  createdAt                        DateTime?
  updatedAt                        DateTime?
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         Json?
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     Json
  postLogoutRedirectUris           Json?
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       Json?
  responseTypes                    Json?
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?              @default(false)
  referenceId                      String?
  metadata                         Json?
  user                             User?                 @relation(fields: [userId], references: [id])
  resources                        OauthClientResource[]
  refreshTokens                    OauthRefreshToken[]
  accessTokens                     OauthAccessToken[]
  consents                         OauthConsent[]
  mcpOrganizations                 McpOrganization[]

  @@index([userId])
  @@map("oauthClient")
}

model OauthResource {
  id                            String                @id
  identifier                    String                @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 Json?
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?              @default(false)
  disabled                      Boolean?              @default(false)
  createdAt                     DateTime?
  updatedAt                     DateTime?
  policyVersion                 Int?                  @default(1)
  metadata                      Json?
  clients                       OauthClientResource[]

  @@map("oauthResource")
}

model OauthClientResource {
  id         String        @id
  clientId   String
  resourceId String
  metadata   Json?
  createdAt  DateTime?
  client     OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resource   OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)

  @@unique([clientId, resourceId])
  @@index([clientId])
  @@index([resourceId])
  @@map("oauthClientResource")
}

model OauthRefreshToken {
  id                      String             @id
  token                   String             @unique
  clientId                String
  sessionId               String?
  userId                  String
  referenceId             String?
  authorizationCodeId     String?
  resources               Json?
  requestedUserInfoClaims Json?
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  Json
  client                  OauthClient        @relation(fields: [clientId], references: [clientId])
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user                    User               @relation(fields: [userId], references: [id])
  accessTokens            OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauthRefreshToken")
}

model OauthAccessToken {
  id                      String             @id
  token                   String             @unique
  clientId                String
  sessionId               String?
  userId                  String?
  referenceId             String?
  authorizationCodeId     String?
  resources               Json?
  requestedUserInfoClaims Json?
  refreshId               String?
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  confirmation            Json?
  scopes                  Json
  client                  OauthClient        @relation(fields: [clientId], references: [clientId])
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user                    User?              @relation(fields: [userId], references: [id])
  refresh                 OauthRefreshToken? @relation(fields: [refreshId], references: [id])

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauthAccessToken")
}

model OauthConsent {
  id                      String      @id
  clientId                String
  userId                  String?
  referenceId             String?
  resources               Json?
  requestedUserInfoClaims Json?
  scopes                  Json
  createdAt               DateTime
  updatedAt               DateTime
  client                  OauthClient @relation(fields: [clientId], references: [clientId])
  user                    User?       @relation(fields: [userId], references: [id])

  @@index([clientId])
  @@index([userId])
  @@map("oauthConsent")
}

model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime

  @@map("oauthClientAssertion")
}

// --- BetterAuth organization plugin models ---

model Organization {
  id                    String                 @id
  name                  String
  slug                  String                 @unique
  logo                  String?
  metadata              String?
  createdAt             DateTime               @default(now())
  members               Member[]
  invitations           Invitation[]
  collections           Collection[]
  queues                Queue[]
  queueSchedules        QueueSchedule[]
  records               Record[]
  rowFilters            RowFilter[]
  fieldFilters          FieldFilter[]
  files                 File[]
  notifications         Notification[]
  notificationSchedules NotificationSchedule[]
  casbinRules           CasbinRule[]
  auditLogs             AuditLog[]
  secrets               Secret[]
  collectionTriggers    CollectionTrigger[]
  transactionRequests   TransactionRequest[]
  recordHistory         RecordHistory[]

  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  userId         String
  role           String       @default("member")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  permissions    String       @default("[]")
  id             String       @id
  organizationId String
  email          String
  role           String?
  status         String       @default("pending")
  inviterId      String
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// --- Application models ---

model Collection {
  id           String              @id
  orgId        String              @map("org_id")
  name         String
  schema       Json
  description  String              @default("")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  org          Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  records      Record[]
  files        File[]
  rowFilters   RowFilter[]
  fieldFilters FieldFilter[]
  triggers     CollectionTrigger[]
  history      RecordHistory[]

  @@unique([orgId, name])
  @@unique([orgId, id])
  @@index([orgId])
  @@map("collections")
}

model Record {
  id           String       @id
  orgId        String       @map("org_id")
  collectionId String       @map("collection_id")
  data         Json
  createdBy    String       @default("system") @map("created_by")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  collection   Collection   @relation(fields: [orgId, collectionId], references: [orgId, id], onDelete: Cascade)
  files        File[]

  outgoingReferences RecordReference[]  @relation("ReferenceSource")
  incomingReferences RecordReference[]  @relation("ReferenceTarget")
  attachments        RecordAttachment[]

  @@unique([orgId, id])
  @@index([orgId, collectionId])
  @@map("records")
}

// Position orders mutations even when their timestamps are identical. It stays internal.
model RecordHistory {
  position     Int                 @id @default(autoincrement())
  id           String              @unique
  orgId        String              @map("org_id")
  collectionId String              @map("collection_id")
  recordId     String              @map("record_id")
  operation    String
  actorId      String              @map("actor_id")
  changeSetId  String              @map("change_set_id")
  before       Json?
  after        Json?
  createdAt    DateTime            @default(now()) @map("created_at")
  org          Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  collection   Collection          @relation(fields: [orgId, collectionId], references: [orgId, id], onDelete: Cascade)
  files        RecordHistoryFile[]

  @@unique([orgId, id])
  @@index([orgId, collectionId, position])
  @@index([orgId, collectionId, recordId, position])
  @@index([orgId, changeSetId])
  @@index([createdAt])
  @@map("record_history")
}

model RowFilter {
  id           String       @id
  orgId        String       @map("org_id")
  collectionId String       @map("collection_id")
  role         String
  action       String
  condition    Json
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  collection   Collection   @relation(fields: [orgId, collectionId], references: [orgId, id], onDelete: Cascade)

  @@unique([orgId, collectionId, role, action])
  @@index([orgId, collectionId, action])
  @@map("row_filters")
}

model FieldFilter {
  id             String       @id
  orgId          String       @map("org_id")
  collectionId   String       @map("collection_id")
  role           String
  action         String
  readableFields Json         @map("readable_fields")
  writableFields Json         @map("writable_fields")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  collection     Collection   @relation(fields: [orgId, collectionId], references: [orgId, id], onDelete: Cascade)

  @@unique([orgId, collectionId, role, action])
  @@index([orgId, collectionId, action])
  @@map("field_filters")
}

model File {
  id           String       @id
  orgId        String       @map("org_id")
  path         String
  filename     String
  mimeType     String?      @map("mime_type")
  sizeBytes    Int?         @map("size_bytes")
  collectionId String?      @map("collection_id")
  recordId     String?      @map("record_id")
  uploadedBy   String       @default("system") @map("uploaded_by")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  collection   Collection?  @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  record       Record?      @relation(fields: [recordId], references: [id], onDelete: SetNull)

  standalone   Boolean             @default(true)
  attachments  RecordAttachment[]
  historyFiles RecordHistoryFile[]

  @@unique([orgId, id])
  @@unique([orgId, path])
  @@index([orgId, collectionId])
  @@index([orgId, recordId])
  @@map("files")
}

model Notification {
  id              String                @id
  orgId           String                @map("org_id")
  userId          String                @map("user_id")
  createdByUserId String?               @map("created_by_user_id")
  scheduleId      String?               @map("schedule_id")
  occurrenceAt    DateTime?             @map("occurrence_at")
  dedupeKey       String?               @map("dedupe_key")
  type            String
  message         String
  data            Json?
  read            Boolean               @default(false)
  inApp           Boolean               @default(true) @map("in_app")
  channel         String                @default("console")
  status          String                @default("pending")
  errorLogs       Json?                 @map("error_logs")
  channelResults  Json?                 @map("channel_results")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  org             Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule        NotificationSchedule? @relation(fields: [orgId, scheduleId], references: [orgId, id], onDelete: Restrict)

  @@unique([orgId, userId, dedupeKey])
  @@unique([orgId, scheduleId, occurrenceAt, userId])
  @@index([orgId, userId, read])
  @@map("notifications")
}

model NotificationSchedule {
  id               String         @id
  orgId            String         @map("org_id")
  userId           String         @map("user_id")
  audience         Json
  dedupeKey        String         @map("dedupe_key")
  type             String
  subject          String
  message          String
  data             Json?
  deliverAt        DateTime?      @map("deliver_at")
  recurrence       String?
  nextOccurrenceAt DateTime?      @map("next_occurrence_at")
  status           String         @default("scheduled")
  lockedAt         DateTime?      @map("locked_at")
  lastEnqueuedAt   DateTime?      @map("last_enqueued_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  org              Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications    Notification[]

  @@unique([orgId, id])
  @@unique([orgId, userId, dedupeKey])
  @@index([status, deliverAt])
  @@index([status, nextOccurrenceAt])
  @@index([orgId, userId, status])
  @@map("notification_schedules")
}

model CasbinRule {
  id    Int          @id @default(autoincrement())
  orgId String       @map("org_id")
  ptype String
  v0    String?
  v1    String?
  v2    String?
  v3    String?
  v4    String?
  v5    String?
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, ptype])
  @@index([orgId, v0])
  @@map("casbin_rule")
}

model DeviceCode {
  id              String    @id
  deviceCode      String    @unique
  userCode        String    @unique
  userId          String?
  expiresAt       DateTime
  status          String
  lastPolledAt    DateTime?
  pollingInterval Int?
  clientId        String?
  scope           String?

  @@map("deviceCode")
}

model AuditLog {
  id           String       @id
  orgId        String       @map("org_id")
  userId       String       @default("system") @map("user_id")
  action       String
  resourceType String       @map("resource_type")
  resourceId   String?      @map("resource_id")
  details      Json?
  createdAt    DateTime     @default(now()) @map("created_at")
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@index([orgId, resourceType, resourceId])
  @@map("audit_log")
}

// Active organization for one account's MCP client. It survives token refresh.
// Keep orgId after deletion or membership removal so requests require reselection.
model McpOrganization {
  userId   String
  clientId String
  orgId    String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@id([userId, clientId])
  @@map("mcp_organization")
}

model FileUpload {
  id         String   @id
  orgId      String
  userId     String
  attachment Json?
  tokenHash  String   @unique
  status     String   @default("pending")
  filename   String?
  path       String?
  mimeType   String?
  sizeBytes  Int?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([expiresAt])
  @@index([orgId, userId])
  @@map("file_upload")
}

// Ciphertext is deliberately separate from public metadata and ordinary exports.
model Secret {
  id         String       @id
  orgId      String       @map("org_id")
  name       String
  keyVersion String       @map("key_version")
  ciphertext String
  nonce      String
  authTag    String       @map("auth_tag")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@index([orgId, createdAt, id])
  @@index([orgId, keyVersion, id])
  @@map("secrets")
}

// --- Durable queues ---

model Queue {
  id                String              @id
  orgId             String              @map("org_id")
  name              String
  schema            Json
  schemaVersion     Int                 @default(1) @map("schema_version")
  enabled           Boolean             @default(true)
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  org               Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  maxAttempts       Int                 @default(3) @map("max_attempts")
  retryDelaySeconds Int                 @default(30) @map("retry_delay_seconds")
  leaseSeconds      Int                 @default(60) @map("lease_seconds")
  retentionDays     Int                 @default(7) @map("retention_days")
  entries           QueueEntry[]
  schedules         QueueSchedule[]
  triggers          CollectionTrigger[]

  @@unique([orgId, name])
  @@unique([orgId, id])
  @@index([orgId, id])
  @@map("queues")
}

// Payload, schema version and producer identity are written only at enqueue.
// A nullable key permits independent unkeyed entries; keyed requests also store
// their canonical content hash for conflict detection during idempotency replay.
model QueueEntry {
  id               String   @id
  queueId          String   @map("queue_id")
  payload          Json
  schemaVersion    Int      @map("schema_version")
  producerUserId   String?  @map("producer_user_id")
  availableAt      DateTime @default(now()) @map("available_at")
  idempotencyKey   String?  @map("idempotency_key")
  idempotencyHash  String?  @map("idempotency_hash")
  createdAt        DateTime @default(now()) @map("created_at")
  queue            Queue    @relation(fields: [queueId], references: [id], onDelete: Cascade)
  producer         User?    @relation(fields: [producerUserId], references: [id], onDelete: SetNull)
  claimedBy        String?  @map("claimed_by")
  claimTokenHash   String?  @map("claim_token_hash")
  nativeClaimToken String?  @map("native_claim_token")
  claimedAttempt   Int      @default(0) @map("claimed_attempt")

  @@unique([queueId, id])
  @@unique([queueId, idempotencyKey])
  @@index([queueId, createdAt, id])
  @@map("queue_entries")
}

model TransactionRequest {
  id          String       @id
  orgId       String       @map("org_id")
  principalId String       @map("principal_id")
  key         String
  requestHash String       @map("request_hash")
  response    Json
  visibility  Json
  expiresAt   DateTime     @map("expires_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, principalId, key])
  @@index([expiresAt])
  @@map("transaction_requests")
}

// The creator remains the execution principal even when another administrator
// edits the schedule. Cursor advancement belongs to occurrence materialization.
model QueueSchedule {
  id               String       @id
  orgId            String       @map("org_id")
  createdBy        String       @map("created_by")
  queueId          String       @map("queue_id")
  payload          Json
  deliverAt        DateTime?    @map("deliver_at")
  recurrence       String?
  timezone         String?
  status           String       @default("active")
  pauseReason      String?      @map("pause_reason")
  cursorAt         DateTime?    @map("cursor_at")
  nextOccurrenceAt DateTime?    @map("next_occurrence_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  creator          User         @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  queue            Queue        @relation(fields: [orgId, queueId], references: [orgId, id], onDelete: Cascade)

  occurrences QueueScheduleOccurrence[]

  @@unique([orgId, id])
  @@index([status, nextOccurrenceAt, id])
  @@index([orgId, createdAt, id])
  @@index([orgId, createdBy, status])
  @@map("queue_schedules")
}

// --- Collection trigger configuration ---

model CollectionTrigger {
  id            String       @id
  orgId         String       @map("org_id")
  createdBy     String       @map("created_by")
  collectionId  String       @map("collection_id")
  queueId       String       @map("queue_id")
  events        Json
  watchedFields Json?        @map("watched_fields")
  where         Json?
  mapping       Json
  status        String       @default("active")
  pauseReason   String?      @map("pause_reason")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  creator       User         @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  collection    Collection   @relation(fields: [orgId, collectionId], references: [orgId, id], onDelete: Cascade)
  queue         Queue        @relation(fields: [orgId, queueId], references: [orgId, id], onDelete: Cascade)

  @@index([orgId, createdAt, id])
  @@index([orgId, collectionId, status])
  @@map("collection_triggers")
}

// Durable publication identity survives queue-entry retention.
model QueueScheduleOccurrence {
  id           String        @id
  scheduleId   String        @map("schedule_id")
  occurrenceAt DateTime      @map("occurrence_at")
  entryId      String        @map("entry_id")
  createdAt    DateTime      @default(now()) @map("created_at")
  schedule     QueueSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, occurrenceAt])
  @@map("queue_schedule_occurrences")
}

// SQLite transactional publication bridge; removed after Bunqueue acknowledges persistence.
model JobOutbox {
  id        String   @id
  message   Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("job_outbox")
}

model RecordReference {
  orgId    String @map("org_id")
  sourceId String @map("source_id")
  field    String
  targetId String @map("target_id")
  position Int
  source   Record @relation("ReferenceSource", fields: [orgId, sourceId], references: [orgId, id], onDelete: Cascade)
  target   Record @relation("ReferenceTarget", fields: [orgId, targetId], references: [orgId, id], onDelete: Cascade)

  @@id([sourceId, field, targetId])
  @@index([orgId, targetId])
  @@map("record_references")
}

model RecordAttachment {
  orgId    String @map("org_id")
  recordId String @map("record_id")
  field    String
  fileId   String @map("file_id")
  position Int
  record   Record @relation(fields: [orgId, recordId], references: [orgId, id], onDelete: Cascade)
  file     File   @relation(fields: [orgId, fileId], references: [orgId, id], onDelete: Cascade)

  @@id([recordId, field, fileId])
  @@index([orgId, fileId])
  @@map("record_attachments")
}

model RecordHistoryFile {
  orgId     String        @map("org_id")
  historyId String        @map("history_id")
  field     String
  fileId    String        @map("file_id")
  history   RecordHistory @relation(fields: [orgId, historyId], references: [orgId, id], onDelete: Cascade)
  file      File          @relation(fields: [orgId, fileId], references: [orgId, id], onDelete: Cascade)

  @@id([historyId, field, fileId])
  @@index([orgId, fileId])
  @@map("record_history_files")
}
