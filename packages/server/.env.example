# Core server
NODE_ENV=development
PORT=8787
DATABASE_URL=file:./data/lastsaas.db

# Authentication
# Replace this development value with a securely generated secret in production.
BETTER_AUTH_SECRET=development-only-change-before-production
BETTER_AUTH_URL=http://localhost:8787

# Optional Google OAuth (set both values or leave both empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email delivery (an empty SMTP_HOST logs messages to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="The Last SaaS <notifications@localhost>"

# File storage
STORAGE_TYPE=local
STORAGE_PATH=./data/files
MAX_UPLOAD_SIZE=52428800

# Generous per-user abuse guard for authenticated /v1 API traffic. Better Auth
# manages its own authentication rate limits. Set RATE_LIMIT_ENABLED=false to
# disable this guard for a trusted installation.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=6000
RATE_LIMIT_WINDOW_SECONDS=60

# S3-compatible storage (used when STORAGE_TYPE=s3)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false
