{
  "name": "@lastsaas/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api": "./src/app.ts"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:generate:postgres": "bun ../../scripts/generate-postgres-schema.ts && prisma generate --schema prisma/schema.postgres.prisma",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lastsaas/shared": "workspace:*",
    "@prisma/client": "^6.16.2",
    "better-auth": "1.5.5",
    "casbin": "^5.49.0",
    "hono": "^4.9.8",
    "luxon": "^3.7.2",
    "rrule": "^2.8.1",
    "zod": "^4.1.11"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.1103.0",
    "@aws-sdk/lib-storage": "^3.1103.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "prisma": "^6.16.2"
  }
}
