{
  "name": "@lastsaas/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api": "./src/app.ts"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:generate:postgres": "bun ../../scripts/generate-postgres-schema.ts && prisma generate --schema prisma/schema.postgres.prisma",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/mcp": "^0.3.2",
    "@lastsaas/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/client": "^6.16.2",
    "better-auth": "1.5.5",
    "busboy": "^1.6.0",
    "casbin": "^5.49.0",
    "croner": "^10.0.1",
    "hono": "^4.9.8",
    "luxon": "^3.7.2",
    "nodemailer": "^7.0.6",
    "pg-boss": "^12.15.0",
    "rate-limiter-flexible": "^11.2.0",
    "rrule": "^2.8.1",
    "zod": "^4.1.11"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.1103.0",
    "@aws-sdk/lib-storage": "^3.1103.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/busboy": "^1.5.4",
    "@types/nodemailer": "^7.0.1",
    "prisma": "^6.16.2"
  }
}
